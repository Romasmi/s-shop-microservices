    "item": [
        {
            "name": "1. Create User",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const response = pm.response.json();",
                            "pm.collectionVariables.set(\"e2e_userId\", response.id);",
                            "pm.collectionVariables.set(\"e2e_username\", response.username);",
                            "pm.collectionVariables.set(\"e2e_password\", response.password);",
                            "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                            "",
                            "const loginRequest = {",
                            "  url: pm.collectionVariables.get(\"baseUrl\") + '/auth/login',",
                            "  method: 'POST',",
                            "  header: { 'Content-Type': 'application/json' },",
                            "  body: {",
                            "    mode: 'raw',",
                            "    raw: JSON.stringify({",
                            "      login: response.username,",
                            "      password: response.password",
                            "    })",
                            "  }",
                            "};",
                            "",
                            "pm.sendRequest(loginRequest, function (err, res) {",
                            "    if (!err) {",
                            "        pm.collectionVariables.set(\"e2e_token\", res.json().token);",
                            "        console.log(\"E2E Token obtained\");",
                            "    }",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"e2e_{{$randomUserName}}\",\n  \"firstName\": \"{{$randomFirstName}}\",\n  \"lastName\": \"{{$randomLastName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"phone\": \"{{$randomPhoneNumber}}\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/user",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "user"
                    ]
                }
            }
        },
        {

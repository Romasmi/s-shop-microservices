@startuml
participant Client
participant "order-service" as OS
participant "user-service" as US
participant "warehouse-service" as WS
participant "delivery-service" as DS
participant "billing-service" as BS
participant Kafka
participant "notification-service" as NS

Client -> OS: PlaceOrder
OS -> US: GetUser
US --> OS: User data

OS -> WS: ReserveProduct
alt warehouse success
    WS --> OS: reservationId
    OS -> DS: ReserveCourier
    alt delivery success
        DS --> OS: courierId
        OS -> BS: Withdraw
        alt billing success
            BS --> OS: success=true
            OS -> WS: ReleaseProduct (commit)
            OS -> OS: status=SUCCESS
            OS -> Kafka: order.placed
            OS --> Client: SUCCESS
        else billing failed
            BS --> OS: success=false
            OS -> DS: CancelCourier
            OS -> WS: CancelReservation
            OS -> OS: status=FAILED
            OS --> Client: FAILED
        end
    else delivery failed
        DS --> OS: failed
        OS -> WS: CancelReservation
        OS -> OS: status=FAILED
        OS --> Client: FAILED
    end
else warehouse failed
    WS --> OS: failed
    OS -> OS: status=FAILED
    OS --> Client: FAILED
end

Kafka -> NS: consume order.placed
NS -> NS: log INFO
@enduml
